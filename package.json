{
  "name": "sauda",
  "version": "0.1.0",
  "private": true,
  "description": "Sauda: a live two-party deal room where a maker and a buyer negotiate a custom order in their own languages, with PayPal Invoicing running the money.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "concurrently -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --disable-warning=ExperimentalWarning --import tsx --watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "smoke:gemini": "node --disable-warning=ExperimentalWarning --import tsx scripts/smoke-gemini.ts",
    "smoke:tts": "node --disable-warning=ExperimentalWarning --import tsx scripts/smoke-tts.ts",
    "smoke:paypal": "node --disable-warning=ExperimentalWarning --import tsx scripts/smoke-paypal.ts",
    "webhooks": "node --disable-warning=ExperimentalWarning --import tsx scripts/webhooks.ts",
    "secret-scan": "node scripts/secret-scan.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@google/genai": "^3.0.0",
    "@paypal/agent-toolkit": "^1.11.0",
    "ajv": "^8.20.0",
    "fastify": "^5.12.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
