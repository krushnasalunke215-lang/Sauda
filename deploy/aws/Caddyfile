# Caddy site for the hosted demo on AWS Lightsail. sauda-redeploy installs it as /etc/caddy/Caddyfile.
# sslip.io resolves 184-193-2-247.sslip.io to the static IP 184.193.2.247, and Caddy gets and
# renews its Let's Encrypt certificate by itself.
{
	# The Lightsail firewall opens TCP 443 only, so HTTP/3 (UDP) is not offered.
	servers {
		protocols h1 h2
	}
}

184-193-2-247.sslip.io {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8787
}
