# Sauda configuration.
# Copy this file to .env (git-ignored) and fill in the values. Never commit .env.
# Non-empty values in .env win over variables already set in your shell.
# PORT (default 8787) and DATA_DIR (default ./data) come from the process environment
# and do not belong in this file.

# --- PayPal (SANDBOX ONLY) ---
# Sauda only ever calls https://api-m.sandbox.paypal.com; there is no setting for the live API.
# Developer Dashboard > Sandbox > Apps & Credentials > your REST app. The app needs the
# Invoicing feature enabled and must be linked to a US business sandbox account
# (partial payment is not available to India-registered accounts).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Email of the US business sandbox account the REST app is linked to (the maker, the invoicer).
PAYPAL_MERCHANT_EMAIL=

# Email of a US personal sandbox account (the buyer who pays the invoice in the browser).
# Only the email goes here, never the password.
PAYPAL_BUYER_EMAIL=

# --- Gemini ---
# vertex: a Vertex AI API key used in express mode (no project or location needed).
# aistudio: a key from https://aistudio.google.com/apikey
GEMINI_BACKEND=vertex
GEMINI_API_KEY=

# Each turn tries the fast model first (thinking level LOW) and falls back to the second
# model on a timeout, an error or an invalid answer.
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-4-argon
GEMINI_FAST_TIMEOUT_MS=8000
GEMINI_FALLBACK_TIMEOUT_MS=30000
